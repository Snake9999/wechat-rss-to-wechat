{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/wechat-cover-skill/payload-schema.json",
  "title": "WeChatCoverPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "style",
    "accent",
    "variant",
    "language"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Primary headline text for the cover."
    },
    "subtitle": {
      "type": "string",
      "description": "Optional one-line thesis or supporting text."
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 8,
      "description": "Short visual cues used to stabilize image direction."
    },
    "style": {
      "type": "string",
      "enum": [
        "swiss",
        "editorial"
      ]
    },
    "accent": {
      "type": "string",
      "enum": [
        "ikb",
        "lemon-yellow",
        "lemon-green",
        "safety-orange",
        "none"
      ]
    },
    "variant": {
      "type": "string",
      "enum": [
        "wechat-21x9",
        "wechat-share-1x1"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "description": "Locale or language tag such as zh-CN or en-US."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "style": {
            "const": "editorial"
          }
        },
        "required": [
          "style"
        ]
      },
      "then": {
        "properties": {
          "accent": {
            "const": "none"
          }
        }
      }
    }
  ]
}
